@page "/"

@page "/menu"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using ParkSmartRD.Context
@inject AppDbContext Db

<h3>Bienvenido, Cajero Turno Mañana</h3>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card-stat card-teal"><h2>@espaciosLibres / @espaciosTotal</h2><p>Espacios Libres</p></div>
    </div>
    <div class="col-md-4">
        <div class="card-stat card-purple"><h2>@vehiculosDentro</h2><p>Vehículos Dentro</p></div>
    </div>
    <div class="col-md-4">
        <div class="card-stat card-teal"><h2>RD$ @ingresosHoy.ToString("N2")</h2><p>Ingresos de Hoy</p></div>
    </div>
</div>

<h5 class="mt-4">Accesos rápidos</h5>
<div class="d-flex gap-2 mt-2">
    <a href="/registrar-entrada" class="btn btn-outline-primary">Registrar Entrada</a>
    <a href="/registrar-salida" class="btn btn-outline-secondary">Registrar Salida</a>
    <a href="/disponibilidad" class="btn btn-outline-success">Ver Disponibilidad</a>
</div>

@code {
    private int espaciosLibres;
    private int espaciosTotal;
    private int vehiculosDentro;
    private decimal ingresosHoy;

    protected override async Task OnInitializedAsync()
    {
        espaciosTotal = await Db.Espacios.CountAsync();
        espaciosLibres = await Db.Espacios.CountAsync(e => e.Estado == "Libre");
        vehiculosDentro = await Db.RegistraEntradas.CountAsync(r => r.Estado);
        ingresosHoy = await Db.Transacciones
            .Where(t => t.FechaHora >= DateTime.Today)
            .SumAsync(t => (decimal?)t.Monto) ?? 0;
    }
}
